{
  "private": true,
  "name": "clipboard-sync",
  "scripts": {
    "dev": "turbo dev --continue",
    "build": "turbo build",
    "lint": "turbo lint --continue",
    "lint:fix": "turbo lint:fix --continue",
    "clean": "turbo clean --continue && rm -rf node_modules/.cache/ .turbo/ **/*/.turbo/",
    "deps:update": "taze",
    "deps:upgrade": "taze -w"
  },
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "taze": "^21.3.0",
    "turbo": "^2.11.7"
  }
}
