{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "cache": false
    },
    "check:fix": {
      "cache": false
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
