{
  "private": true,
  "name": "@clipboard-sync/client",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev:ts": "vite",
    "dev": "tauri dev",
    "build:ts": "tsc -b && vite build",
    "build": "tauri build",
    "lint:ts": "tsc -b --noEmit && eslint . && prettier --check .",
    "lint:ts:fix": "tsc -b --noEmit && eslint . --fix && prettier --write .",
    "lint:rust": "(cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings)",
    "lint:rust:fix": "(cd src-tauri && cargo fmt && cargo clippy --fix --allow-dirty --allow-staged --all-targets -- -D warnings)",
    "lint": "conc --kill-others-on-fail npm:lint:ts npm:lint:rust",
    "lint:fix": "conc --kill-others-on-fail npm:lint:ts:fix npm:lint:rust:fix",
    "clean": "rm -rf dist/ src-tauri/target/"
  },
  "dependencies": {
    "@mantine/core": "^9.6.3",
    "@mantine/form": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@tabler/icons-react": "^3.48.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.4.1",
    "@tauri-apps/plugin-log": "~2.10.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "immer": "^11.1.18",
    "mantine-form-zod-resolver": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@clipboard-sync/eslint-config": "workspace:*",
    "@clipboard-sync/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
