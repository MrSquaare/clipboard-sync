{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipboard Sync",
  "mainBinaryName": "Clipboard Sync",
  "version": "0.2.1-pre.1",
  "identifier": "fr.mrsquaare.clipboard-sync",
  "build": {
    "beforeDevCommand": "pnpm dev:ts",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:ts",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clipboard Sync",
        "width": 800,
        "height": 600,
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc://localhost ws: wss: https:",
        "img-src": "'self' asset: https://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxNkU0Mzg4Rjc3Qzc3RDUKUldUVmQzejNpRU51c1V6YlV6WEg2MDA1Q0tjYytWQzJ2VFV4S2NHaVFCTlFkZUozOERUVzY2UHMK"
    }
  }
}
