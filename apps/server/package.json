{
  "private": true,
  "name": "@clipboard-sync/server",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "build": "rm -rf dist && tsc",
    "deploy": "wrangler deploy --minify --env=''",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run src",
    "test:coverage": "vitest run --coverage src",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "hono": "^4.12.16",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@clipboard-sync/eslint-config": "workspace:*",
    "@clipboard-sync/schemas": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.17",
    "@vitest/coverage-istanbul": "^4.1.5",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5",
    "wrangler": "^4.87.0"
  }
}
