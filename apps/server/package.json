{
  "private": true,
  "name": "@clipboard-sync/server",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "build": "rm -rf dist && tsc",
    "deploy": "wrangler deploy --minify --env=''",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@clipboard-sync/eslint-config": "workspace:*",
    "@clipboard-sync/shared": "workspace:*",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
